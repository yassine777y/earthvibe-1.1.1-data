# Optional PostgreSQL connection for persistent provenance caching.
# The app works without this value and uses an in-memory cache instead.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Comma-separated list of EXTRA origins allowed to call /api/* from a browser.
# Leave empty for same-origin only (recommended).
CORS_ALLOWED_ORIGINS=

# Optional speech-to-text for the voice agent (POST /api/transcribe).
# Point this at any service that accepts multipart "file" audio and returns {"text": "..."},
# for example a self-hosted Whisper endpoint. Leave empty to use typing / the device's own
# speech recognition instead — the app then reports transcription as not configured.
# TRANSCRIBE_API_URL=http://127.0.0.1:8000/transcribe
