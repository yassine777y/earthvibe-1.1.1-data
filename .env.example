# Optional PostgreSQL connection for persistent provenance caching.
# The app works without this value and uses an in-memory cache instead.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Comma-separated list of EXTRA origins allowed to call /api/* from a browser.
# Leave empty for same-origin only (recommended).
CORS_ALLOWED_ORIGINS=
